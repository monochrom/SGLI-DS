{
  "breakpoint": {
    "sm": {
      "$type": "dimension",
      "$value": "480px"
    },
    "md": {
      "$type": "dimension",
      "$value": "768px",
      "$extensions": {
        "com.figma.mode": "Tablet"
      }
    },
    "lg": {
      "$type": "dimension",
      "$value": "1024px",
      "$extensions": {
        "com.figma.mode": "Desktop"
      }
    },
    "xl": {
      "$type": "dimension",
      "$value": "1280px"
    },
    "2xl": {
      "$type": "dimension",
      "$value": "1440px"
    }
  }
}
